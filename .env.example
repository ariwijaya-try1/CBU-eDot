# Salin jadi .env lalu isi nilainya. JANGAN commit .env.

# Aplikasi
APP_NAME=Odoo-eSuite Bridge
ENV=production
REQUEST_TIMEOUT=15

# Odoo (JSON-RPC, source of truth)
ODOO_BASE_URL=
ODOO_DB=
ODOO_UID=
ODOO_API_KEY=

# eSuite (push target), contoh sandbox: https://openapistg.esuite.edot.id/v1/webhook
ESUITE_BASE_URL=
ESUITE_CLIENT_ID=
ESUITE_CLIENT_SECRET=

# API key bridge (header x-api-key; juga dipakai login Edot Bridge UI)
API_KEY=
